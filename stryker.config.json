{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/engine/resolution.ts",
    "src/engine/statuses.ts",
    "src/engine/turnPipeline.ts",
    "src/engine/actionResolution.ts",
    "src/engine/invariants.ts",
    "src/engine/heroes/paladin.ts",
    "src/engine/heroes/bloodmage.ts",
    "src/engine/heroes/berserker.ts",
    "src/engine/heroes/werewolf.ts",
    "src/runtime/rng.ts",
    "src/runtime/faults.ts",
    "src/runtime/executor.ts",
    "src/telemetry/replayer.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 85
  },
  "reporters": ["html", "clear-text", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
