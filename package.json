{
  "name": "roguelike-engine",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "description": "A deterministic rule engine used as a system under test: property-based testing, seeded RNG with a NIST/Diehard statistical battery, byte-perfect replay, Monte Carlo simulation with return metrics, and a certification-style evidence pack.",
  "keywords": [
    "testing",
    "property-based-testing",
    "fast-check",
    "mutation-testing",
    "stryker",
    "deterministic",
    "seeded-rng",
    "monte-carlo",
    "nist-sp-800-22",
    "replay",
    "invariants",
    "bdd",
    "cucumber",
    "playwright",
    "qa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ariless/roguelike-engine.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/ui/tsconfig.json",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "stability": "tsx scripts/stability.ts",
    "replay": "tsx scripts/generate-replay.ts",
    "test:mutation": "stryker run",
    "test:ui": "playwright test tests/ui",
    "chaos": "tsx scripts/chaos-agent.ts",
    "ci-report": "tsx scripts/ci-report.ts",
    "trace": "tsx scripts/trace-analysis.ts",
    "test:bdd": "tsx node_modules/.bin/cucumber-js --config cucumber.json",
    "oracle": "tsx scripts/llm-oracle.ts",
    "semantic-mutations": "tsx scripts/semantic-mutations.ts",
    "spec-to-test": "tsx scripts/spec-to-test.ts",
    "ci-summary": "tsx scripts/ci-summary.ts",
    "meta-oracle": "tsx scripts/meta-oracle.ts",
    "cert-evidence": "tsx scripts/cert-evidence.ts",
    "delta": "tsx scripts/delta.ts",
    "check:conventions": "tsx scripts/check-conventions.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.20.1",
    "fast-check": "^4.8.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "qs": "^6.15.3"
  }
}
